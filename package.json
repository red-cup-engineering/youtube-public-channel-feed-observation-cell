    "@red-cup-engineering/a2a-sovereign-operation-boundary-service": "workspace:*",
    "@lenticule-science/witness-journal-rdf-projection-service": "workspace:*",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "workspace:*"
  }
}
